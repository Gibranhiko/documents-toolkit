# Entornos virtuales
.venv/
venv/
env/

# Cache de Python / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Herramientas
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Carpetas de trabajo: archivos originales y resultados (contienen datos personales).
# Se conserva la carpeta en el repo (.gitkeep) pero se ignora su contenido.
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# Salidas generadas por los comandos (pueden contener datos personales)
*.xlsx
*.xls
xml_renombrados/
originalFiles/
.tmp.pdf
._ov_*.pdf

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
